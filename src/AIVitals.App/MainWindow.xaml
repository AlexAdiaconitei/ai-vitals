            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xEA18;" /><TextBlock VerticalAlignment="Center" Text="{DynamicResource PrivacyTab}" /></StackPanel></TabItem.Header>
                <StackPanel MaxWidth="850" HorizontalAlignment="Left"><TextBlock Text="{DynamicResource DataControl}" FontSize="28" FontWeight="SemiBold" /><TextBlock Margin="0,5,0,20" Text="{DynamicResource PrivacyDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" /><Border Style="{StaticResource PanelCard}" BorderBrush="{DynamicResource DangerBrush}"><StackPanel><TextBlock Text="{DynamicResource LocalDeletion}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource DangerBrush}" /><TextBlock Margin="0,8,0,15" Text="{DynamicResource DeleteDescription}" TextWrapping="Wrap" /><Button HorizontalAlignment="Left" Style="{StaticResource ActionButton}" Content="{DynamicResource DeleteAll}" Click="OnDeleteAll" /></StackPanel></Border></StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE790;" /><TextBlock VerticalAlignment="Center" Text="{DynamicResource AppearanceTab}" /></StackPanel></TabItem.Header>
                <StackPanel MaxWidth="850" HorizontalAlignment="Left"><TextBlock Text="{DynamicResource AppearanceTitle}" FontSize="28" FontWeight="SemiBold" /><TextBlock Margin="0,5,0,20" Text="{DynamicResource AppearanceDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" /><Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" /><ComboBox x:Name="LanguageSelector" Width="260" Margin="0,8,0,16" HorizontalAlignment="Left"><ComboBoxItem Content="{DynamicResource Spanish}" Tag="es" /><ComboBoxItem Content="{DynamicResource English}" Tag="en" /></ComboBox><TextBlock Text="{DynamicResource Theme}" FontWeight="SemiBold" /><ComboBox x:Name="ThemeSelector" Width="260" Margin="0,8,0,16" HorizontalAlignment="Left"><ComboBoxItem Content="{DynamicResource SystemTheme}" Tag="System" /><ComboBoxItem Content="{DynamicResource DarkTheme}" Tag="Dark" /><ComboBoxItem Content="{DynamicResource LightTheme}" Tag="Light" /></ComboBox><TextBlock Text="{DynamicResource HighContrastStatus}" Foreground="{DynamicResource MutedTextBrush}" /><Button Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Content="{DynamicResource SaveAppearance}" Click="OnSaveAppearance" /></StackPanel></Border></StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE946;" /><TextBlock VerticalAlignment="Center" Text="{DynamicResource AboutTab}" /><Ellipse x:Name="AboutUpdateDot" Visibility="Collapsed" Width="7" Height="7" Margin="7,1,0,0" VerticalAlignment="Center" Fill="{DynamicResource SignalBrush}" /></StackPanel></TabItem.Header>
                <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                    <TextBlock Text="{DynamicResource AboutTitle}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,20" Text="{DynamicResource AboutDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource InstalledVersion}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="InstalledVersionValue" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource UpdateChannel}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="UpdateChannelValue" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="UpdateReadyCard" Visibility="Collapsed" Margin="0,18,0,0" Padding="12,10" CornerRadius="10"
                                    Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource SignalBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="UpdateReadyText" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Margin="14,0,0,0" Style="{StaticResource PrimaryButton}" Content="{DynamicResource UpdateInstallAndRestart}" Click="OnInstallUpdate" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="UpdateStatusText" Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="UpdateLastCheckedText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                            <CheckBox x:Name="AutomaticUpdateCheck" Margin="0,18,0,0" Style="{StaticResource WidgetSwitch}" Content="{DynamicResource AutomaticUpdateCheck}" />
                            <CheckBox x:Name="StartWithWindows" Margin="0,6,0,0" Style="{StaticResource WidgetSwitch}" Content="{DynamicResource StartWithWindows}" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource SaveUpdatePreferences}" Click="OnSaveUpdatePreferences" />
                                <Button x:Name="CheckForUpdatesButton" Style="{StaticResource ActionButton}" Content="{DynamicResource CheckForUpdates}" Click="OnCheckForUpdates" />
                                <Button Style="{StaticResource ActionButton}" Content="{DynamicResource OpenReleases}" Click="OnOpenReleases" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0"><TextBlock VerticalAlignment="Center" Text="{DynamicResource LocalFirstFooter}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="ActionStatus" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite" /></Grid>
        </Border>
    </Grid>
</Window>
