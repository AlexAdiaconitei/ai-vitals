<Window x:Class="AIVitals.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIVitals.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AI Vitals"
        Icon="pack://application:,,,/AIVitals.App;component/Assets/AppIcon.ico"
        Width="1440" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavIcon" TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FontSize" Value="17" />
        </Style>

        <Style x:Key="ProjectLinkButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkChrome" Padding="{TemplateBinding Padding}" CornerRadius="7"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkChrome" Property="Background" Value="{DynamicResource ElevatedBrush}" />
                                <Setter TargetName="LinkChrome" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="LinkChrome" Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" CornerRadius="6" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid Margin="12,0,10,0">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Width="9" Height="5"
                                                      Fill="{TemplateBinding Foreground}" Data="M 0 0 L 4.5 5 L 9 0 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320" Margin="0,4,0,0" Padding="4"
                                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="7">
                                    <ScrollViewer CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource WarmBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7,18,7" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="WidgetSwitch" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,18,6" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="FocusChrome" Padding="2" CornerRadius="14"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SwitchTrack" Width="38" Height="20" CornerRadius="10"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                    <Ellipse x:Name="SwitchThumb" Width="14" Height="14" Margin="2"
                                             HorizontalAlignment="Left"
                                             Fill="{DynamicResource MutedTextBrush}" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource SignalBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusChrome" Property="BorderBrush" Value="{DynamicResource WarmBrush}" />
                                <Setter TargetName="FocusChrome" Property="BorderThickness" Value="2" />
                                <Setter TargetName="FocusChrome" Property="Padding" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource PanelBrush}" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ElevatedBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,8" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavBorder" Padding="{TemplateBinding Padding}" CornerRadius="7"
                                Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource ScrollThumbBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="QuotaBandTemplate">
            <Border Margin="0,0,0,10" Padding="14,11" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding PeriodText}" FontWeight="SemiBold" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding UsageText}" FontFamily="Cascadia Mono, Consolas" FontSize="25" FontWeight="Bold" />
                    <local:UsageMeter Grid.Row="2" Height="8" Value="{Binding UsageValue}" SignalBrush="{DynamicResource CodexBrush}" TrackBrush="{DynamicResource LineBrush}" />
                    <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding ResetText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Right" Text="{Binding FreshnessText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <local:ActivityRingsIcon Width="29" Height="29" VerticalAlignment="Center"
                                         OuterBrush="{DynamicResource SignalBrush}" MiddleBrush="{DynamicResource CodexBrush}"
                                         InnerBrush="{DynamicResource WarmBrush}" TrackBrush="{DynamicResource LineBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AI Vitals" FontSize="17" FontWeight="SemiBold" />
                    <Border Height="22" Margin="12,0,0,0" Padding="8,0" VerticalAlignment="Center" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
                        <TextBlock VerticalAlignment="Center" Text="LOCAL" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource SignalBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource RecoveryShortcutHelp}">
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource RecoveryShortcut}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    <Border Margin="12,0,0,0" Padding="10,5" CornerRadius="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <TextBlock Text="Ctrl + Shift + U" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="12,0,-20,0" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowButton}" Click="OnMinimizeWindow" AutomationProperties.Name="Minimizar"><TextBlock Style="{StaticResource FluentIcon}" FontSize="11" Text="&#xE921;" /></Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnMaximizeWindow" AutomationProperties.Name="Maximizar"><TextBlock Style="{StaticResource FluentIcon}" FontSize="11" Text="&#xE922;" /></Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnCloseWindow" AutomationProperties.Name="Cerrar"><TextBlock Style="{StaticResource FluentIcon}" FontSize="11" Text="&#xE8BB;" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="DashboardTabs" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" KeyboardNavigation.TabNavigation="Local" SelectionChanged="OnDashboardSectionChanged">
            <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></TabControl.ItemsPanel>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="202" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                            <DockPanel Margin="0,12,0,14">
                                <Border DockPanel.Dock="Bottom" Margin="18,14,18,0" Padding="12" CornerRadius="7" Background="{DynamicResource WidgetSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ProjectLinks}" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" />
                                        <Button Style="{StaticResource ProjectLinkButton}" Click="OnOpenGitHub">
                                            <StackPanel Orientation="Horizontal"><local:SvgLogo Width="17" Height="17" Source="Assets/Providers/github.svg" Tint="{DynamicResource TextBrush}" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{DynamicResource OpenGitHub}" FontSize="11" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ProjectLinkButton}" Click="OnOpenKoFi">
                                            <StackPanel Orientation="Horizontal"><local:SvgLogo Width="17" Height="17" Source="Assets/Providers/kofi.svg" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{DynamicResource SupportKoFi}" FontSize="11" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <ItemsPresenter />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CanvasBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" Margin="22,18" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" /><TextBlock VerticalAlignment="Center" Text="{DynamicResource SummaryTab}" /></StackPanel></TabItem.Header>
                <Grid>
                <Grid Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="150" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource PopupTitle}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{DynamicResource HeaderDescription}" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelCard}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource SignalBrush}" BorderThickness="1">
                                        <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SignalBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Codex" FontSize="21" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource Quotas}" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CodexHealthText}" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="{DynamicResource SignalBrush}" />
                                </Grid>
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding CodexBands}" ItemTemplate="{StaticResource QuotaBandTemplate}" />
                                <TextBlock Grid.Row="3" Margin="0,6,0,0" HorizontalAlignment="Right" Text="{Binding CodexObservedText}" Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource WarmSurfaceBrush}" BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1">
                                        <TextBlock Text="CC" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WarmBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Claude Code" FontSize="21" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource Quotas}" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding ClaudeHealthText}" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="{DynamicResource WarmBrush}" />
                                </Grid>
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding ClaudeBands}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="14,11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" AutomationProperties.Name="{Binding AccessibleName}">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding PeriodText}" FontWeight="SemiBold" />
                                                    <TextBlock HorizontalAlignment="Right" Text="{Binding UsageText}" FontFamily="Cascadia Mono, Consolas" FontSize="25" FontWeight="Bold" />
                                                    <local:UsageMeter Grid.Row="2" Height="8" Value="{Binding UsageValue}" SignalBrush="{DynamicResource WarmBrush}" TrackBrush="{DynamicResource LineBrush}" />
                                                    <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding ResetText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Right" Text="{Binding FreshnessText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="3" Margin="0,6,0,0" HorizontalAlignment="Right" Text="{Binding ClaudeObservedText}" Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelCard}">
                            <Grid><StackPanel><TextBlock Text="{DynamicResource DataControl}" FontSize="18" FontWeight="SemiBold" /><TextBlock Margin="0,7,0,0" Text="{DynamicResource PrivacyDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel><TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="SQLite · JSON" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource SignalBrush}" /></Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                            <Grid><StackPanel><TextBlock Text="{DynamicResource WidgetEditor}" FontSize="18" FontWeight="SemiBold" /><TextBlock Margin="0,7,0,0" Text="{DynamicResource WidgetDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource ActionButton}" Content="{DynamicResource MoveToCurrentDisplay}" Click="OnMoveWidgetHere" /></Grid>
                        </Border>
                    </Grid>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>

                        <Grid Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SummaryTab}" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0" Text="{DynamicResource DashboardSubtitle}" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Right" Text="{DynamicResource LastUpdateLabel}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding HistoryStatus}" FontSize="10" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}" Click="OnRefreshHistory" AutomationProperties.Name="{DynamicResource Refresh}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE72C;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DashboardCard}" BorderBrush="{DynamicResource CodexBrush}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <local:SvgLogo Width="43" Height="43" HorizontalAlignment="Left"
                                                       Source="Assets/Providers/codex-dark.svg" Tint="{DynamicResource CodexBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Codex" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CodexHealthText}" FontSize="11" Foreground="{DynamicResource CodexBrush}" />
                                        </StackPanel>
