<Window x:Class="AIVitals.App.QuickPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIVitals.App"
        Title="{DynamicResource PopupWindowTitle}"
        Icon="pack://application:,,,/AIVitals.App;component/Assets/AppIcon.ico"
        Width="440" Height="610" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" CornerRadius="8"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ElevatedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WarmBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="CodexPopupBand">
            <Grid Margin="0,7,0,3">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="7" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding PeriodText}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding UsageText}" FontFamily="Cascadia Mono, Consolas" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource CodexBrush}" />
                <local:UsageMeter Grid.Row="1" Height="7" Value="{Binding UsageValue}" SignalBrush="{DynamicResource CodexBrush}" TrackBrush="{DynamicResource LineBrush}" />
                <TextBlock Grid.Row="2" Margin="0,5,0,0" Text="{Binding ResetText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Grid.Row="2" Margin="0,5,0,0" HorizontalAlignment="Right" Text="{Binding FreshnessText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ClaudePopupBand">
            <Grid Margin="0,7,0,3">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="7" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding PeriodText}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding UsageText}" FontFamily="Cascadia Mono, Consolas" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WarmBrush}" />
                <local:UsageMeter Grid.Row="1" Height="7" Value="{Binding UsageValue}" SignalBrush="{DynamicResource WarmBrush}" TrackBrush="{DynamicResource LineBrush}" />
                <TextBlock Grid.Row="2" Margin="0,5,0,0" Text="{Binding ResetText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Grid.Row="2" Margin="0,5,0,0" HorizontalAlignment="Right" Text="{Binding FreshnessText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="9" CornerRadius="16" Background="{DynamicResource WidgetGlassBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="7" Opacity="0.48" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="92" /></Grid.RowDefinitions>
            <Border Padding="18,14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <local:ActivityRingsIcon Width="44" Height="44"
                                             OuterBrush="{DynamicResource SignalBrush}" MiddleBrush="{DynamicResource CodexBrush}"
                                             InnerBrush="{DynamicResource WarmBrush}" TrackBrush="{DynamicResource LineBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AI Vitals" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding HistoryStatus}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Width="34" Height="34" Margin="0,0,6,0" Padding="0" Style="{StaticResource PopupButton}" Click="OnOpenDashboard" ToolTip="{DynamicResource PopupOpenDashboard}"><TextBlock Style="{StaticResource FluentIcon}" FontSize="13" Text="&#xE80F;" /></Button>
                        <Button Width="34" Height="34" Padding="0" Style="{StaticResource PopupButton}" Click="OnClose" AutomationProperties.Name="{DynamicResource PopupCloseAccessibleName}"><TextBlock Style="{StaticResource FluentIcon}" FontSize="13" Text="&#xE711;" /></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14">
                    <Border Padding="14" CornerRadius="9" Background="{DynamicResource WidgetSurfaceBrush}" BorderBrush="{DynamicResource CodexBrush}" BorderThickness="1,1,1,2">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal"><local:SvgLogo Width="23" Height="23" Source="Assets/Providers/codex-dark.svg" Tint="{DynamicResource CodexBrush}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="Codex" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding CodexHealthText}" FontSize="10" Foreground="{DynamicResource CodexBrush}" /></StackPanel></StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CodexBands}" ItemTemplate="{StaticResource CodexPopupBand}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0" Padding="14" CornerRadius="9" Background="{DynamicResource WidgetSurfaceBrush}" BorderBrush="{DynamicResource WarmBrush}" BorderThickness="1,1,1,2">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal"><local:SvgLogo Width="23" Height="23" Source="Assets/Providers/claude-ai.svg" Tint="{DynamicResource ClaudeBrandBrush}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="Claude Code" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding ClaudeHealthText}" FontSize="10" Foreground="{DynamicResource WarmBrush}" /></StackPanel></StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ClaudeBands}" ItemTemplate="{StaticResource ClaudePopupBand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16,9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="6" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource TrayWidgetControls}" FontSize="12" FontWeight="SemiBold" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="ToggleWidgetButton" Width="30" Height="28" Margin="0,0,5,0" Padding="0" Style="{StaticResource PopupButton}" Click="OnToggleWidget" ToolTip="{DynamicResource ShowWidget}"><local:WidgetGlyph x:Name="WidgetVisibilityGlyph" Width="15" Height="15" StrokeBrush="{DynamicResource MutedTextBrush}" /></Button>
                        <Button x:Name="LockWidgetButton" Width="30" Height="28" Margin="0,0,5,0" Padding="0" Style="{StaticResource PopupButton}" Click="OnToggleWidgetLock" ToolTip="{DynamicResource LockPosition}"><local:WidgetGlyph x:Name="WidgetLockGlyph" Width="15" Height="15" StrokeBrush="{DynamicResource MutedTextBrush}" /></Button>
                        <Button x:Name="ClickThroughButton" Width="30" Height="28" Margin="0,0,5,0" Padding="0" Style="{StaticResource PopupButton}" Click="OnToggleClickThrough" ToolTip="{DynamicResource ClickThrough}"><local:WidgetGlyph x:Name="WidgetClickThroughGlyph" Width="15" Height="15" StrokeBrush="{DynamicResource MutedTextBrush}" /></Button>
                        <Button Width="30" Height="28" Padding="0" Style="{StaticResource PopupButton}" Click="OnRecoverWidget" ToolTip="{DynamicResource RecoverPosition}"><TextBlock Style="{StaticResource FluentIcon}" FontSize="12" Text="&#xE72C;" /></Button>
                    </StackPanel>
                    <UniformGrid Grid.Row="2" Rows="1" Columns="3">
                        <Button x:Name="RingsButton" Margin="0,0,4,0" Padding="8,6" Style="{StaticResource PopupButton}" Click="OnWidgetRings"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:WidgetGlyph Width="14" Height="14" Kind="Rings" StrokeBrush="{DynamicResource MutedTextBrush}" /><TextBlock Margin="6,0,0,0" Text="{DynamicResource Rings}" /></StackPanel></Button>
                        <Button x:Name="HorizontalButton" Margin="2,0" Padding="8,6" Style="{StaticResource PopupButton}" Click="OnWidgetHorizontal"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:WidgetGlyph Width="14" Height="14" Kind="HorizontalBars" StrokeBrush="{DynamicResource MutedTextBrush}" /><TextBlock Margin="6,0,0,0" Text="{DynamicResource HorizontalShort}" /></StackPanel></Button>
                        <Button x:Name="VerticalButton" Margin="4,0,0,0" Padding="8,6" Style="{StaticResource PopupButton}" Click="OnWidgetVertical"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:WidgetGlyph Width="14" Height="14" Kind="VerticalBars" StrokeBrush="{DynamicResource MutedTextBrush}" /><TextBlock Margin="6,0,0,0" Text="{DynamicResource VerticalShort}" /></StackPanel></Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
